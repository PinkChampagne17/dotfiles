# `.nu` is ambiguous between Nu and Nushell; this repository uses Nushell.
*.nu linguist-language=Nushell
*.mdc linguist-language=Markdown

# Extensionless files with unambiguous script or template content.
home/dot_bashrc linguist-language=Shell
home/.chezmoiignore linguist-language=Go-Template

# Data configuration: improve GitHub file recognition without forcing language statistics.
configs/dash-to-panel-config linguist-language=INI
home/mydotfiles/.prototools linguist-language=TOML
home/mydotfiles/ghostty/config linguist-language=INI
home/dot_gitconfig linguist-language=Git-Config
home/dot_wslconfig linguist-language=INI
