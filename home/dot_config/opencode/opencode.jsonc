{
  // TODO: Switch to the OpenCode V2 config schema when upstream publishes one.
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "default_agent": "plan",
  "enabled_providers": ["ai-gateway"],
  "model": "ai-gateway/deepseek-v4.1-flash",
  "providers": {
    "ai-gateway": {
      "name": "AI Gateway",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "{env:OPENAI_BASE_URL}",
      },
      // AI Gateway model catalog: https://ai-gateway.vercel.sh/v1/models
      "models": {
        "claude-sonnet-5": {
          "modelID": "anthropic/claude-sonnet-5",
          "name": "Claude Sonnet 5",
          "cost": {
            "input": 2,
            "output": 10,
            "cache": {
              "read": 0.2,
              "write": 2.5,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-opus-5": {
          "modelID": "anthropic/claude-opus-5",
          "name": "Claude Opus 5",
          "cost": {
            "input": 5,
            "output": 25,
            "cache": {
              "read": 0.5,
              "write": 6.25,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-fable-5.1": {
          "modelID": "anthropic/claude-fable-5.1",
          "name": "Claude Fable 5.1",
          "cost": {
            "input": 10,
            "output": 50,
            "cache": {
              "read": 1,
              "write": 12.5,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "deepseek-v4.1-flash": {
          "modelID": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cache": {
              "read": 0.015,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "gemini-3.1-pro-preview": {
          "modelID": "google/gemini-3.1-pro-preview",
          "name": "Gemini 3.1 Pro Preview",
          "cost": {
            "input": 2,
            "output": 12,
            "cache": {
              "read": 0.2,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 64000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "gemini-3.8-flash": {
          "modelID": "google/gemini-3.8-flash",
          "name": "Gemini 3.8 Flash",
          "cost": {
            "input": 0.75,
            "output": 3.75,
            "cache": {
              "read": 0.075,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 65536,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf", "video"],
            "output": ["text"],
          },
        },
        "gpt-6.1-sol": {
          "modelID": "openai/gpt-6.1-sol",
          "name": "GPT-6.1 Sol",
          "cost": {
            "input": 2,
            "output": 10,
            "cache": {
              "read": 0.1,
              "write": 2.5,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "gpt-6.1-sol-fast": {
          "modelID": "openai/gpt-6.1-sol-fast",
          "name": "GPT-6.1 Sol (Fast)",
          "cost": {
            "input": 4,
            "output": 20,
            "cache": {
              "read": 0.2,
              "write": 5,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "gpt-6-luna": {
          "modelID": "openai/gpt-6-luna",
          "name": "GPT-6 Luna",
          "cost": {
            "input": 0.1,
            "output": 0.5,
            "cache": {
              "read": 0.01,
              "write": 0.125,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "gpt-6-luna-fast": {
          "modelID": "openai/gpt-6-luna-fast",
          "name": "GPT-6 Luna (Fast)",
          "cost": {
            "input": 0.2,
            "output": 1,
            "cache": {
              "read": 0.02,
              "write": 0.25,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "glm-5.3": {
          "modelID": "zai/glm-5.3",
          "name": "GLM 5.3",
          "cost": {
            "input": 1.1,
            "output": 3.851,
            "cache": {
              "read": 0.275,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
          },
        },
        "glm-5.3-flash": {
          "modelID": "zai/glm-5.3-flash",
          "name": "GLM 5.3 Flash",
          "cost": {
            "input": 2.1,
            "output": 6.6,
            "cache": {
              "read": 0.21,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
          },
        },
        "kimi-k3": {
          "modelID": "moonshotai/kimi-k3",
          "name": "Kimi K3",
          "cost": {
            "input": 3,
            "output": 15,
            "cache": {
              "read": 0.3,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "kimi-k3-fast": {
          "modelID": "moonshotai/kimi-k3-fast",
          "name": "Kimi K3 Fast",
          "cost": {
            "input": 4.5,
            "output": 22.5,
            "cache": {
              "read": 0.45,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "compaction": {
    "auto": true,
    // Auto-compaction triggers when estimated tokens reach:
    //   min(input limit - buffer, limit.context - max(output reserve, buffer))
    // The output reserve is capped at 32000. All models here use
    // limit.context = 1000000 and have no explicit input limit, so
    // buffer = 808000 keeps the trigger at ~192k.
    // Caveat: buffer is global, so a model with a different limit.context
    // shifts the trigger (e.g. a 2M window would trigger at 1192000).
    "buffer": 808000,
  },
}
