{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "plan",
  "lsp": true,
  "enabled_providers": ["ai-gateway"],
  "model": "ai-gateway/deepseek-v4.1-flash",
  "provider": {
    "ai-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Gateway",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "{env:OPENAI_BASE_URL}",
      },
      // AI Gateway model catalog: https://ai-gateway.vercel.sh/v1/models
      "models": {
        "claude-sonnet-5": {
          "id": "anthropic/claude-sonnet-5",
          "name": "Claude Sonnet 5",
          "cost": {
            "input": 2,
            "output": 10,
            "cache_read": 0.2,
            "cache_write": 2.5,
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-opus-5": {
          "id": "anthropic/claude-opus-5",
          "name": "Claude Opus 5",
          "cost": {
            "input": 5,
            "output": 25,
            "cache_read": 0.5,
            "cache_write": 6.25,
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-fable-5": {
          "id": "anthropic/claude-fable-5",
          "name": "Claude Fable 5",
          "cost": {
            "input": 10,
            "output": 50,
            "cache_read": 1,
            "cache_write": 12.5,
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "deepseek-v4.1-flash": {
          "id": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cache_read": 0.015,
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "gemini-3.1-pro-preview": {
          "id": "google/gemini-3.1-pro-preview",
          "name": "Gemini 3.1 Pro Preview",
          "cost": {
            "input": 2,
            "output": 12,
            "cache_read": 0.2,
          },
          "limit": {
            "context": 1000000,
            "output": 64000,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "gemini-3.6-flash": {
          "id": "google/gemini-3.6-flash",
          "name": "Gemini 3.6 Flash",
          "cost": {
            "input": 1.5,
            "output": 7.5,
            "cache_read": 0.15,
          },
          "limit": {
            "context": 1000000,
            "output": 64000,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "gemini-3.8-flash": {
          "id": "google/gemini-3.8-flash",
          "name": "Gemini 3.8 Flash",
          "cost": {
            "input": 0.75,
            "output": 3.75,
            "cache_read": 0.075,
          },
          "limit": {
            "context": 1000000,
            "output": 65536,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image", "pdf", "video"],
            "output": ["text"],
          },
        },
        "glm-5.2": {
          "id": "zai/glm-5.2",
          "name": "GLM 5.2",
          "cost": {
            "input": 1.1,
            "output": 3.851,
            "cache_read": 0.275,
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "glm-5.2-fast": {
          "id": "zai/glm-5.2-fast",
          "name": "GLM 5.2 Fast",
          "cost": {
            "input": 2.1,
            "output": 6.6,
            "cache_read": 0.21,
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "kimi-k3": {
          "id": "moonshotai/kimi-k3",
          "name": "Kimi K3",
          "cost": {
            "input": 3,
            "output": 15,
            "cache_read": 0.3,
          },
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "kimi-k3-fast": {
          "id": "moonshotai/kimi-k3-fast",
          "name": "Kimi K3 Fast",
          "cost": {
            "input": 4.5,
            "output": 22.5,
            "cache_read": 0.45,
          },
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "compaction": {
    "auto": true,
    // Auto-compaction triggers when estimated tokens exceed:
    //   limit.context - max(limit.output, reserved)
    // All models here use limit.context = 1000000 and limit.output = 384000,
    // so reserved = 1000000 - 256000 = 744000 keeps the trigger at ~256k.
    // Caveat: reserved is global, so a model with a different limit.context
    // shifts the trigger (e.g. a 2M window would trigger at 1256000).
    "reserved": 744000,
  },
}
