{
  // TODO: Switch to the OpenCode V2 config schema when upstream publishes one.
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "default_agent": "plan",
  "enabled_providers": ["ai-gateway"],
  "model": "ai-gateway/gemini-4-argon",
  "providers": {
    "ai-gateway": {
      "name": "AI Gateway",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "{env:OPENAI_BASE_URL}",
      },
      // AI Gateway model catalog: https://ai-gateway.vercel.sh/v1/models
      "models": {
        "claude-sonnet-5.5": {
          "modelID": "anthropic/claude-sonnet-5.5",
          "name": "Claude Sonnet 5.5",
          "cost": {
            "input": 2,
            "output": 10,
            "cache": {
              "read": 0.1,
              "write": 2.5,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-opus-5.5": {
          "modelID": "anthropic/claude-opus-5.5",
          "name": "Claude Opus 5.5",
          "cost": {
            "input": 4,
            "output": 20,
            "cache": {
              "read": 0.2,
              "write": 5,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-fable-5.1": {
          "modelID": "anthropic/claude-fable-5.1",
          "name": "Claude Fable 5.1",
          "cost": {
            "input": 10,
            "output": 50,
            "cache": {
              "read": 1,
              "write": 12.5,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "deepseek-v4.1-flash": {
          "modelID": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cache": {
              "read": 0.015,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "gemini-4-argon": {
          "modelID": "google/gemini-4-argon",
          "name": "Gemini 4 Argon",
          "cost": {
            "input": 2,
            "output": 10,
            "cache": {
              "read": 0.1,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 1000000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf", "video"],
            "output": ["text"],
          },
        },
        "gpt-6.1-sol": {
          "modelID": "openai/gpt-6.1-sol",
          "name": "GPT-6.1 Sol",
          "cost": {
            "input": 2,
            "output": 10,
            "cache": {
              "read": 0.1,
              "write": 2.5,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "gpt-6.1-sol-fast": {
          "modelID": "openai/gpt-6.1-sol-fast",
          "name": "GPT-6.1 Sol (Fast)",
          "cost": {
            "input": 4,
            "output": 20,
            "cache": {
              "read": 0.2,
              "write": 5,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "gpt-6-astra": {
          "modelID": "openai/gpt-6-astra",
          "name": "GPT-6 Astra",
          "cost": {
            "input": 10,
            "output": 50,
            "cache": {
              "read": 1,
              "write": 12.5,
            },
          },
          "limit": {
            "context": 1050000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "gpt-6-luna": {
          "modelID": "openai/gpt-6-luna",
          "name": "GPT-6 Luna",
          "cost": {
            "input": 0.1,
            "output": 0.5,
            "cache": {
              "read": 0.01,
              "write": 0.125,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "gpt-6-luna-fast": {
          "modelID": "openai/gpt-6-luna-fast",
          "name": "GPT-6 Luna (Fast)",
          "cost": {
            "input": 0.2,
            "output": 1,
            "cache": {
              "read": 0.02,
              "write": 0.25,
            },
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "compaction": {
    "auto": true,
    // Auto-compaction triggers when estimated tokens reach:
    //   min(input limit - buffer, limit.context - max(output reserve, buffer))
    // The output reserve is capped at 32000. All models here use
    // limit.context = 1000000 and have no explicit input limit, so
    // buffer = 808000 keeps the trigger at ~192k.
    // Caveat: buffer is global, so a model with a different limit.context
    // shifts the trigger (e.g. a 2M window would trigger at 1192000).
    "buffer": 808000,
  },
}
