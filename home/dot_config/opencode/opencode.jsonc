{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "plan",
  "lsp": true,
  "enabled_providers": ["ai-gateway"],
  "model": "ai-gateway/gemini-3.7-flash",
  "provider": {
    "ai-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Gateway",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "{env:OPENAI_BASE_URL}",
      },
      // AI Gateway model catalog: https://ai-gateway.vercel.sh/v1/models
      "models": {
        "claude-sonnet-5": {
          "id": "anthropic/claude-sonnet-5",
          "name": "Claude Sonnet 5",
          "cost": {
            "input": 2,
            "output": 10,
            "cache_read": 0.2,
            "cache_write": 2.5,
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-opus-5": {
          "id": "anthropic/claude-opus-5",
